# backend/.env untuk server lokal. JANGAN dibagikan / di-commit ke GitHub publik.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=warung_bu_cucun
# Alamat yang dipakai membuka aplikasi (pisahkan dengan koma kalau lebih dari satu)
CORS_ORIGINS=http://192.168.1.10
APP_URL=http://192.168.1.10
# Ganti dengan: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_TEKS_ACAK_PANJANG
STORE_TZ=Asia/Jakarta
# Ganti dengan: openssl rand -hex 24 (dipakai crontab untuk laporan malam / backup / WA pagi)
WEBHOOK_CRON_SECRET=GANTI_DENGAN_TEKS_ACAK_LAIN
# Opsional:
# BACKUP_DIR=/opt/warung/backend/backups
# PROMO_SEND_DELAY_SECONDS=6
